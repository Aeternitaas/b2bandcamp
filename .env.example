# Copy to .env and fill in before running `docker compose up`.
# Generate strong values, e.g.:  openssl rand -base64 24

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

MYSQL_DATABASE=b2bandcamp
MYSQL_USER=b2bandcamp

# Host port the app is published on.
APP_PORT=9185

# How long a sign-in lasts.
SESSION_TTL_DAYS=30

# Set false after creating your accounts to close the instance to new sign-ups.
ALLOW_REGISTRATION=true

# Set true when serving over HTTPS (e.g. behind a reverse proxy with TLS).
# Leave false for plain http://localhost:9185 or cookies will not be sent.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Deploying behind a domain
# ---------------------------------------------------------------------------
# Nothing in the app hardcodes a hostname: the UI calls /api relatively and
# builds share links from the address you are browsing. These two only matter
# once a reverse proxy is in front.

# Canonical public address. Optional — set it so copied share links always name
# your domain, even when the app was opened over a LAN address.
# PUBLIC_BASE_URL=https://music.example.com

# Networks whose X-Forwarded-For may be trusted. Required behind a proxy:
# without it every request looks like it came from the proxy, so all users share
# one rate-limit bucket and one person's failed logins lock out everybody.
# "private" covers loopback plus the RFC1918 ranges, which is what a proxy on
# the same host or docker network will be. Never set this to a public range.
# TRUSTED_PROXIES=private

# Dev stack (docker-compose.dev.yml) — kept off the production ports.
DEV_API_PORT=9186
WEB_PORT=5173
