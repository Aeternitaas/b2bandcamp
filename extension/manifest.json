{
  "manifest_version": 3,
  "name": "b2bandcamp Playlist Adder",
  "version": "1.0.0",
  "description": "Add tracks and albums from Bandcamp straight into your b2bandcamp playlists.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "b2bandcamp",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*.bandcamp.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://*.bandcamp.com/*"],
      "js": ["content/inject.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "109"
}
